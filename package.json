{
    "name": "tailwind-hitslop",
    "version": "0.2.2",
    "packageManager": "bun@1.4.4",
    "description": "Hit-slop utilities for Tailwind CSS v4 (and v3 via plugin) — invisible expanded touch targets, like React Native's hitSlop.",
    "license": "MIT",
    "author": "İlker Balcılar",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jubstaaa/tailwind-hitslop.git"
    },
    "homepage": "https://hitslop.ilkerbalcilar.com",
    "bugs": "https://github.com/Jubstaaa/tailwind-hitslop/issues",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/Jubstaaa"
        },
        {
            "type": "buy_me_a_coffee",
            "url": "https://buymeacoffee.com/jubstaa"
        }
    ],
    "style": "./dist/index.css",
    "types": "./dist/plugin.d.ts",
    "exports": {
        ".": {
            "types": "./dist/plugin.d.ts",
            "style": "./dist/index.css",
            "require": "./dist/plugin.js",
            "import": "./dist/plugin.js",
            "default": "./dist/index.css"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && cp index.css dist/",
        "test": "vitest run --dir test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "audit": "bun audit --audit-level=high"
    },
    "peerDependencies": {
        "tailwindcss": "^3.0.0 || ^4.0.0"
    },
    "peerDependenciesMeta": {
        "tailwindcss": {
            "optional": true
        }
    },
    "keywords": [
        "tailwindcss",
        "tailwind",
        "hit-slop",
        "hitslop",
        "touch-target",
        "tap-target",
        "a11y",
        "css"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@tailwindcss/node": "^4.3.0",
        "@types/node": "^22",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.0",
        "globals": "^17.0.0",
        "postcss": "^8.5.0",
        "prettier": "^3.4.0",
        "tailwindcss-v3": "npm:tailwindcss@3.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.59.0",
        "vitest": "^5.1.0"
    }
}
